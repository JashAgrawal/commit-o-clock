{
  "name": "commit-o-clock",
  "displayName": "commit-o-clock",
  "icon": "/resources/logo.webp",
  "description": "Automate your commits periodically with AI",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Extension Packs",
    "Other"
  ],
  "publisher": "JashAgrawal",
  "repository": {
    "type": "git",
    "url": "https://github.com/JashAgrawal/commit-o-clock.git"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.aiCommit",
        "title": "AI Commit"
      },
      {
        "command": "extension.toggleAutoCommit",
        "title": "Toggle Auto-Commit"
      },
      {
        "command": "extension.toggleScheduledCommit",
        "title": "Schedule Daily Commit"
      }
    ],
    "keybindings": [
      {
        "command": "extension.aiCommit",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Commit-o-Clock",
      "properties": {
        "gitAutoCommit.interval": {
          "type": "number",
          "default": 30,
          "description": "Commit interval in minutes. Set to 30 for 30 minutes, 60 for 1 hour, etc."
        },
        "gitAutoCommit.inviteCode": {
          "type": "string",
          "default": "INVITECODEHERE",
          "description": "Invite code to test the beta of Commit-o-clock"
        },
        "gitAutoCommit.autoCommitEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable automatic commits"
        },
        "gitAutoCommit.scheduledTime": {
          "type": "string",
          "default": "",
          "description": "Schedule daily commits at specific time (24-hour format, e.g., '14:30' for 2:30 PM)"
        },
        "gitAutoCommit.useScheduledCommit": {
          "type": "boolean",
          "default": false,
          "description": "Enable or disable scheduled commits at specific time"
        },
        "gitAutoCommit.commitFormat": {
          "type": "string",
          "default": "type(scope): description\n\nBody explaining the changes in detail.\n\nFooter with references and breaking changes.",
          "description": "Format template for commit messages. Use placeholders like 'type', 'scope', 'description', etc."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.16.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.7",
    "moment": "^2.30.1",
    "simple-git": "^3.27.0"
  }
}
